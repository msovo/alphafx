# ============================================================
#  AlphaBot FX — Environment Variables (sample)
#  Copy to `.env` and fill in. NEVER commit your real `.env`.
# ============================================================

# --- MetaTrader 5 broker credentials ---
MT5_ACCOUNT=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=                    # Optional: full path to terminal64.exe
MT5_REQUIRE_DEMO=true        # Safety: refuse real/contest accounts when true

# --- MT5 remote bridge (macOS/Linux dev machines only) ---
# Leave blank on the Windows VM itself (it uses MetaTrader5 directly).
# On a Mac/Linux dev machine, set these to reach live MT5 running on the VM
# via `python -m core.mt5_bridge_server` + an SSH/IAP tunnel. See
# deploy/gcp-windows-vm/README.md for the full setup.
MT5_BRIDGE_URL=               # e.g. http://localhost:8600 (tunnel local end)
MT5_BRIDGE_TOKEN=             # shared secret, e.g. `openssl rand -hex 32`

# --- Google Gemini AI ---
# AI_BACKEND: 'studio' (uses GEMINI_API_KEY) or 'vertex' (uses GCP project + ADC)
AI_BACKEND=studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Vertex AI (only when AI_BACKEND=vertex). Run: gcloud auth application-default login
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1

# --- Telegram notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OWNER_CHAT_ID=

# --- News / Calendar ---
NEWS_API_KEY=                # Optional, for premium calendar APIs

# --- Application ---
APP_NAME=AlphaBot FX
APP_VERSION=1.0.0
APP_ENV=development          # development | staging | production
LOG_LEVEL=INFO
DB_PATH=./data/alphabot.db
TIMEZONE=UTC

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8501
DASHBOARD_PASSWORD=          # Phase 2: enable to require login
